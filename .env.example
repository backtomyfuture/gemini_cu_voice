# 填入你的 Google Gemini API Key (AI Studio 免费账号无使用量限制)
GEMINI_API_KEY=your_gemini_api_key_here

# 可选模型:
# 1. gemini-3.8-live (默认，极速超低延迟对话)
# 2. gemini-3.8-live-extended-thinking (带后台深度思考，适合复杂多步电脑操作)
GEMINI_LIVE_MODEL=gemini-3.8-live

# 思考模型思考深度 (仅在 GEMINI_LIVE_MODEL 选用 extended-thinking 时生效，可选: low, medium, high；默认 low)
# GEMINI_THINKING_LEVEL=low

# 会话压缩滑动窗口目标 token 上限 (默认 32000，压缩后保留的最新上下文目标大小)
# CONTEXT_TARGET_TOKENS=32000

# 会话压缩滑动窗口触发门限 token 上限 (默认 100000，当长对话累积上下文超过此值时触发服务端自动增量压缩)
# CONTEXT_TRIGGER_TOKENS=100000

# 可选声音音色: Aoede, Puck, Charon, Kore, Fenrir
GEMINI_VOICE=Aoede

# 本机 kimi-cu 路径
KIMI_CU_PATH=/Applications/KimiCU.app/Contents/MacOS/kimi-cu

# 近场语音门控与防旁人误打断配置 (可选，留空则开机自动自适应计算)
# MIC_THRESHOLD: 近场起呼门限 RMS (默认自适应 140~260，设为如 160 或 180 可彻底屏蔽旁人闲聊)
# MIC_THRESHOLD=160
# INTERRUPT_THRESHOLD: 打断门限 RMS (默认分级自适应：播报350+ / 执行460+，防旁人闲聊误打断)
# INTERRUPT_THRESHOLD=380
